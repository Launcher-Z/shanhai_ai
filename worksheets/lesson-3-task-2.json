    {
      "id": "reflection",
      "step": 1,
      "title": "前后比较 · 数据与识别",
      "optional": false,
      "questions": [
        {
          "id": "experiment-plan",
          "type": "text",
          "prompt": "本次重点研究哪一个因素？与2.2相比，你怎样调整了训练数据，哪些条件尽量保持一致？",
          "required": true,
          "review": true,
          "max_length": 2000
        },
        {
          "id": "training-quality",
          "type": "text",
          "prompt": "新选的图片真的有助于提升训练质量吗？检查类别是否准确、主体是否清晰、背景与数量是否合适；是否需要裁剪、调整尺寸或其他预处理？说明已做的处理或下一步打算。",
          "required": true,
          "review": true,
          "max_length": 2000
        },
        {
          "id": "result-change",
          "type": "text",
          "prompt": "结合具体图片和前后结果，初步判断训练数据怎样影响图像识别。哪些变好了，哪些没有？班级统计能否直接代表你自己的模型？",
          "required": true,
          "review": true,
          "max_length": 2000
        },
        {
          "id": "test-influence",
          "type": "text",
          "prompt": "图6、7、8是虚构对象，为什么仍有两类预测比例？如果只选普通动物，或只选这些虚构对象测试，会怎样影响你对模型效果的判断？你会怎样选择测试数据？",
          "required": true,
          "review": true,
          "max_length": 2000
        }
      ]
    }
